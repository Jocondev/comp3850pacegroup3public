    null\r\n    __String_0: %SystemString, null\r\n    __Boolean_0: %SystemBoolean,
    null\r\n    __obj_0: %UnityEngineGameObject, this\r\n    __instance_2: %UnityEngineUISlider,
    null\r\n    __instance_3: %UnityEngineUISlider, null\r\n    __value_1: %SystemSingle,
    null\r\n    __instance_4: %UnityEngineUISlider, null\r\n    __value_2: %SystemBoolean,
    null\r\n    __obj_1: %UnityEngineGameObject, this\r\n    slider: %UnityEngineUISlider,
    null\r\n    sliderValueText: %UnityEngineUIText, null\r\n    sliderValue: %SystemSingle,
    null\r\n\r\n.data_end\r\n\r\n.code_start\r\n\r\n    .export OnValueChanged\r\n   
    \r\n    OnValueChanged:\r\n    \r\n        PUSH, sliderValueText\r\n        PUSH,
    __instance_0\r\n        COPY\r\n        PUSH, __String_0\r\n        PUSH, __format_0\r\n       
